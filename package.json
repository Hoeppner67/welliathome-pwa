{
  "name": "welliathome-pwa",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-dist.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "verify-dist": "node scripts/verify-dist.mjs",
    "format": "prettier --write src build public/sw.js index.html vite.config.ts vitest.config.ts eslint.config.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dompurify": "^3.4.18",
    "jspdf": "^4.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.1.10",
    "vitest": "^5.1.1",
    "fast-png": "^6.4.0"
  }
}
